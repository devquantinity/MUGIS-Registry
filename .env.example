# Copy to .env (local / production) or .env.staging (staging).
#   npm run dev            → reads .env
#   npm run dev:staging    → reads .env.staging
#   npm run build:staging  → builds with .env.staging
# Real values never go in git: .env and .env.staging are gitignored.

# MUGIS backend (mugis-backend). No trailing slash.
# NEXT_PUBLIC_ values are compiled into the browser bundle — never put a
# secret here.
#
# LOCAL (backend on localhost:8080, which sends no CORS headers): leave this
# EMPTY so the browser calls this app's own origin, and set API_PROXY_TARGET so
# Next forwards /api/v1/* to the backend. No CORS involved.
NEXT_PUBLIC_API_BASE_URL=
API_PROXY_TARGET=http://localhost:8080

# SERVER (staging / production): the real API URL, and no API_PROXY_TARGET.
# nginx on the API host adds the CORS headers for this site's origin.
#   NEXT_PUBLIC_API_BASE_URL=https://staging-api.mugis.gotka.org.my
#   NEXT_PUBLIC_API_BASE_URL=https://api.mugis.gotka.org.my
