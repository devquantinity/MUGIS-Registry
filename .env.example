# Copy to .env (local / production) or .env.staging (staging).
#   npm run dev            → reads .env
#   npm run dev:staging    → reads .env.staging
#   npm run build:staging  → builds with .env.staging
# Real values never go in git: .env and .env.staging are gitignored.

# MUGIS backend (mugis-backend). No trailing slash.
# NEXT_PUBLIC_ values are compiled into the browser bundle — never put a
# secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
